#
# Applies OpenGaussian branding to a runtime resource folder that upstream's build or install has filled:
#   - assets/: our logos written over upstream's file names (no C++ change needed to load them);
#   - locales/: only the shipped languages, with the upstream product name replaced, read from the source tree;
#   - locale_index.json: only the shipped languages.
# Run with cmake -P. Inputs: OG_DIR, OG_LOCALE_SOURCE_DIR, OG_LOCALES and OG_RESOURCE_DIRS ("|"-separated),
# OG_PRODUCT_NAME, OG_UPSTREAM_NAME.

cmake_minimum_required(VERSION 3.30)

foreach(var OG_DIR OG_LOCALE_SOURCE_DIR OG_LOCALES OG_PRODUCT_NAME OG_UPSTREAM_NAME)
    if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
        message(FATAL_ERROR "ApplyBranding: ${var} is required")
    endif()
endforeach()

string(REPLACE "|" ";" og_locales "${OG_LOCALES}")
string(REPLACE "|" ";" og_resource_dirs "${OG_RESOURCE_DIRS}")

# Writes content only when it differs, so unchanged files keep their timestamps.
function(og_write_if_different path content)
    if(EXISTS "${path}")
        file(READ "${path}" current)
        if(current STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

# Branded locale files and the trimmed language index, built once from the source tree.
foreach(code IN LISTS og_locales)
    set(source "${OG_LOCALE_SOURCE_DIR}/${code}.json")
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "ApplyBranding: missing locale ${source}")
    endif()
    file(READ "${source}" original)
    string(REPLACE "${OG_UPSTREAM_NAME}" "${OG_PRODUCT_NAME}" text "${original}")
    string(REPLACE "Lichtfeld Studio" "${OG_PRODUCT_NAME}" text "${text}")

    # Per-language overrides (opengaussian/locales/<code>.json): "keep" restores upstream's text, "set" writes ours.
    set(overrides_file "${OG_DIR}/locales/${code}.json")
    if(EXISTS "${overrides_file}")
        file(READ "${overrides_file}" overrides)
        foreach(kind keep set)
            string(JSON count ERROR_VARIABLE no_entries LENGTH "${overrides}" ${kind})
            if(no_entries OR count EQUAL 0)
                continue()
            endif()
            math(EXPR last_entry "${count} - 1")
            foreach(i RANGE ${last_entry})
                if(kind STREQUAL "keep")
                    string(JSON path_count LENGTH "${overrides}" keep ${i})
                    set(path_json_prefix keep ${i})
                else()
                    string(JSON path_count LENGTH "${overrides}" set ${i} path)
                    set(path_json_prefix set ${i} path)
                endif()
                set(path)
                math(EXPR last_part "${path_count} - 1")
                foreach(j RANGE ${last_part})
                    string(JSON part GET "${overrides}" ${path_json_prefix} ${j})
                    list(APPEND path "${part}")
                endforeach()
                if(kind STREQUAL "keep")
                    string(JSON value GET "${original}" ${path})
                else()
                    string(JSON value GET "${overrides}" set ${i} value)
                endif()
                string(REPLACE "\\" "\\\\" value "${value}")
                string(REPLACE "\"" "\\\"" value "${value}")
                string(REPLACE "\n" "\\n" value "${value}")
                string(JSON text SET "${text}" ${path} "\"${value}\"")
            endforeach()
        endforeach()
    endif()
    set(og_locale_text_${code} "${text}")
endforeach()

file(READ "${OG_LOCALE_SOURCE_DIR}/../locale_index.json" index_text)
string(JSON language_count LENGTH "${index_text}" languages)
set(index_entries)
math(EXPR last "${language_count} - 1")
foreach(i RANGE ${last})
    string(JSON code GET "${index_text}" languages ${i} code)
    if(code IN_LIST og_locales)
        string(JSON entry GET "${index_text}" languages ${i})
        list(APPEND index_entries "    ${entry}")
    endif()
endforeach()
string(JOIN ",\n" index_body ${index_entries})
set(og_index_text "{\n  \"languages\": [\n${index_body}\n  ]\n}\n")

foreach(dir IN LISTS og_resource_dirs)
    if(dir STREQUAL "" OR NOT IS_DIRECTORY "${dir}")
        continue()
    endif()

    if(IS_DIRECTORY "${dir}/assets")
        file(GLOB logos "${OG_DIR}/assets/*.png")
        foreach(logo IN LISTS logos)
            get_filename_component(name "${logo}" NAME)
            file(COPY_FILE "${logo}" "${dir}/assets/${name}" ONLY_IF_DIFFERENT)
        endforeach()
    endif()

    if(IS_DIRECTORY "${dir}/locales")
        file(GLOB shipped "${dir}/locales/*.json")
        foreach(file IN LISTS shipped)
            get_filename_component(code "${file}" NAME_WE)
            if(NOT code IN_LIST og_locales)
                file(REMOVE "${file}")
            endif()
        endforeach()
        foreach(code IN LISTS og_locales)
            og_write_if_different("${dir}/locales/${code}.json" "${og_locale_text_${code}}")
        endforeach()
    endif()

    if(EXISTS "${dir}/locale_index.json")
        og_write_if_different("${dir}/locale_index.json" "${og_index_text}")
    endif()
endforeach()
