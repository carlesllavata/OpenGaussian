// SPDX-License-Identifier: GPL-3.0-or-later
// OpenGaussian version resource (replaces upstream's cmake/windows_version.rc.in, see OpenGaussian.cmake).

LANGUAGE 0x09, 0x01 // US English

1 VERSIONINFO
 FILEVERSION @OG_VERSION_MAJOR@,@OG_VERSION_MINOR@,@OG_VERSION_PATCH@,0
 PRODUCTVERSION @OG_VERSION_MAJOR@,@OG_VERSION_MINOR@,@OG_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL // VS_FFI_FILEFLAGSMASK
 FILEFLAGS $<IF:$<CONFIG:Debug>,0x1L,0x0L> // VS_FF_DEBUG
 FILEOS 0x40004L // VOS_NT_WINDOWS32
 FILETYPE @OG_WINDOWS_FILE_TYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenGaussian contributors\0"
            VALUE "FileDescription", "@OG_WINDOWS_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@OG_VERSION@\0"
            VALUE "InternalName", "@OG_WINDOWS_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "Copyright (c) LichtFeld Studio Authors and OpenGaussian contributors. GPL-3.0-or-later.\0"
            VALUE "OriginalFilename", "@OG_WINDOWS_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "@OG_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@OG_VERSION@\0"
            VALUE "Comments", "Based on @OG_UPSTREAM_NAME@ @PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
